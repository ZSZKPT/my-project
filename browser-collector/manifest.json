{
  "manifest_version": 3,
  "name": "飞凡选款 · 浏览器采集",
  "version": "1.1.0",
  "description": "使用当前 Chrome 的正常登录状态采集选款参考；Pinterest 仅从你的首页推荐读取。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://zszkpt.github.io/*"
  ],
  "optional_host_permissions": [
    "https://*.temu.com/*",
    "https://*.shein.com/*",
    "https://*.lightinthebox.com/*",
    "https://*.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞凡选款采集"
  }
}
